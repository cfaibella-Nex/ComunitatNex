{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/activitats",
      "destination": "/agenda.html",
      "permanent": true
    },
    {
      "source": "/tallers",
      "destination": "/reserves.html?cat=taller",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/agenda",
      "destination": "/agenda.html"
    },
    {
      "source": "/reserves",
      "destination": "/reserves.html"
    },
    {
      "source": "/recursos",
      "destination": "/recursos.html"
    },
    {
      "source": "/passatemps",
      "destination": "/passatemps.html"
    },
    {
      "source": "/legal",
      "destination": "/legal.html"
    },
    {
      "source": "/accessibilitat",
      "destination": "/accessibilitat.html"
    }
  ]
}
