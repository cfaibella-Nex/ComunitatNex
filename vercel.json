{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ],
  "redirects": [
    { "source": "/activitats", "destination": "/agenda.html", "permanent": true },
    { "source": "/tallers", "destination": "/reserves.html?cat=taller", "permanent": true },
    { "source": "/passatemps.html", "destination": "/recursos.html#passatemps", "permanent": true },
    { "source": "/passatemps", "destination": "/recursos.html#passatemps", "permanent": true }
  ]
}
